---
import Base from "../layouts/Base.astro";
import VideoGrid from "../components/VideoGrid.astro";
import TopicGrid from "../components/TopicGrid.astro";
import { SITE, quotes, quoteUrl, shareText, waLink, site_ as site } from "../lib/data";
import { getVideos } from "../lib/videos";

const videos = (await getVideos()).slice(0, 6);
const q0 = quotes[0];
// what the quote-of-the-day script needs, nothing more
const qd = quotes.map((q) => ({ ur: q.ur, roman: q.roman, en: q.en, url: quoteUrl(q), share: shareText(q) }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LumoLifts",
  url: SITE + "/",
  logo: SITE + "/icon-512.png",
  sameAs: ["https://www.youtube.com/@LumoLifts", site.links.tiktok, site.links.facebook],
};
---

<Base
  title="LumoLifts | Urdu Quotes & Life Lessons | اردو اقوال"
  description="Urdu quotes, life lessons and positive mindset in short, calm videos. اردو اقوال، زندگی کے سبق اور مثبت سوچ۔ New Shorts every week."
  path="/"
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="mark"><img src="/logo.png" alt="LumoLifts logo" width="160" height="160" /></div>
    <h1 class="ur" lang="ur" dir="rtl">روشنی بانٹیں، حوصلہ بڑھائیں</h1>
    <p class="lead">Urdu quotes, life lessons and a positive mindset, in short, calm videos.</p>
    <div class="ctas">
      <a class="btn primary" href={site.links.youtube} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="M10 9l5 3-5 3z" fill="var(--btn-ink)"></path></svg>
        Subscribe on YouTube
      </a>
      <a class="btn" href={site.links.tiktok} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h3a4 4 0 0 0 4 4v3a7 7 0 0 1-4-1.3V15a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3z"></path></svg>
        TikTok
      </a>
      <a class="btn" href={site.links.facebook} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.6V4.3A21 21 0 0 0 14.4 4C12 4 10.5 5.5 10.5 8.1v2.4H8v3h2.5V21z"></path></svg>
        Facebook
      </a>
    </div>
  </section>

  <section id="quote" class="wrap">
    <div class="card quote">
      <p class="label"><span class="ur" lang="ur">آج کا قول</span> · Quote of the day</p>
      <blockquote>
        <a id="q-link" href={quoteUrl(q0)} style="text-decoration:none">
          <p id="q-ur" class="ur big" lang="ur" dir="rtl">{q0.ur}</p>
        </a>
        <p id="q-roman" class="roman">{q0.roman}</p>
        <p id="q-en" class="en">{q0.en}</p>
      </blockquote>
      <div class="actions">
        <button type="button" id="q-copy" class="chip" data-copy={shareText(q0)}>Copy</button>
        <a id="q-wa" class="chip" target="_blank" rel="noopener" href={waLink(q0)}>Share on WhatsApp</a>
        <button type="button" id="q-next" class="chip ghost">Next quote →</button>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <div class="head">
      <h2>Browse by topic</h2>
      <a class="more" href="/quotes/">All quotes →</a>
    </div>
    <TopicGrid />
  </section>

  {
    videos.length > 0 && (
      <section id="shorts" class="wrap block">
        <div class="head">
          <h2>Latest Shorts</h2>
          <a class="more" href="/videos/">See all →</a>
        </div>
        <VideoGrid videos={videos} />
      </section>
    )
  }

  <section id="follow" class="wrap block">
    <h2>Follow LumoLifts</h2>
    <div class="follow">
      <a class="card plat" href={site.links.youtube} target="_blank" rel="noopener"><strong>YouTube</strong><span>@LumoLifts</span><em>Shorts every week</em></a>
      <a class="card plat" href={site.links.tiktok} target="_blank" rel="noopener"><strong>TikTok</strong><span>@lumolifts.urdu</span><em>Same reels, first</em></a>
      <a class="card plat" href={site.links.facebook} target="_blank" rel="noopener"><strong>Facebook</strong><span>LumoLifts</span><em>Quotes & reels</em></a>
    </div>
  </section>

  <script is:inline define:vars={{ qd }}>
    let i = Math.floor(Date.now() / 86400000) % qd.length;
    const $ = (id) => document.getElementById(id);
    function show(n) {
      const q = qd[n];
      $("q-ur").textContent = q.ur;
      $("q-roman").textContent = q.roman;
      $("q-en").textContent = q.en;
      $("q-link").href = q.url;
      $("q-copy").dataset.copy = q.share;
      $("q-wa").href = "https://wa.me/?text=" + encodeURIComponent(q.share);
    }
    show(i);
    $("q-next").addEventListener("click", () => show((i = (i + 1) % qd.length)));
  </script>
</Base>
